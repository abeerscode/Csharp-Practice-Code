@model List<Entities.Teacher>

<h2>Teacher List</h2>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>ID</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.Name</td>
                <td>@teacher.Id</td>
                <td>@teacher.Age</td>
            </tr>
        }
    </tbody>
</table>
